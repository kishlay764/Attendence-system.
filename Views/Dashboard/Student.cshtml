@model SmartAttendance.ViewModels.Dashboard.StudentDashboardViewModel
@{
    ViewData["Title"] = "Student Portal";
}

<!-- Low Attendance Alert Banner if < 75% -->
@if (Model.HasLowAttendanceWarning)
{
    <div class="low-attendance-banner d-flex align-items-center gap-3">
        <i class="bi bi-exclamation-triangle-fill fs-2"></i>
        <div class="flex-grow-1">
            <h5 class="fw-bold mb-1">Attention Required: Low Attendance Warning</h5>
            <div style="font-size: 0.9rem;">
                Your cumulative attendance is <strong>@Model.OverallPercentage%</strong>, which falls strictly below the university requirement of <strong>75%</strong>. You are at risk of exam debarment. Please meet your faculty advisor immediately.
            </div>
        </div>
        <div class="badge bg-danger fs-6 px-3 py-2">
            @Model.OverallPercentage% ATTENDANCE
        </div>
    </div>
}

<!-- Student Academic Header -->
<div class="dashboard-card p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h3 class="fw-bold mb-0">@Model.StudentName</h3>
                <span class="badge bg-light text-dark border font-monospace">@Model.RollNumber</span>
            </div>
            <p class="text-muted mb-0 small">
                @Model.CourseName • <strong>@Model.ClassSectionName</strong> (Semester @Model.Semester)
            </p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="text-end">
                <span class="text-muted small">Cumulative Attendance</span>
                <div class="fs-3 fw-bold @(Model.OverallPercentage >= 75 ? "text-success" : "text-danger")">
                    @Model.OverallPercentage%
                </div>
            </div>
            <div class="stat-icon-wrapper @(Model.OverallPercentage >= 75 ? "stat-icon-green" : "stat-icon-red")">
                <i class="bi @(Model.OverallPercentage >= 75 ? "bi-check-circle" : "bi-exclamation-circle")"></i>
            </div>
        </div>
    </div>
</div>

<!-- Attendance Counters -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon-wrapper stat-icon-blue">
                <i class="bi bi-calendar3"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Total Sessions Held</div>
                <div class="stat-value">@Model.TotalSessionsHeld</div>
                <div class="stat-subtitle text-muted">All courses combined</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon-wrapper stat-icon-green">
                <i class="bi bi-person-check-fill"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Present</div>
                <div class="stat-value text-success">@Model.TotalPresent</div>
                <div class="stat-subtitle text-muted">Full credit sessions</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon-wrapper stat-icon-amber">
                <i class="bi bi-clock-history"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Late Arrivals</div>
                <div class="stat-value text-warning">@Model.TotalLate</div>
                <div class="stat-subtitle text-muted">0.5 credit weighted</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon-wrapper stat-icon-red">
                <i class="bi bi-person-x-fill"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Absences</div>
                <div class="stat-value text-danger">@Model.TotalAbsent</div>
                <div class="stat-subtitle text-muted">Zero credit sessions</div>
            </div>
        </div>
    </div>
</div>

<!-- Subject-Wise Attendance Breakdown -->
<div class="dashboard-card p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="fw-bold mb-0">Subject-Wise Attendance Details</h5>
            <small class="text-muted">Minimum threshold: 75.0% per subject requirement</small>
        </div>
    </div>

    @if (Model.SubjectBreakdowns.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Subject</th>
                        <th>Instructor</th>
                        <th class="text-center">Total Sessions</th>
                        <th class="text-center">Attended (P/L/A)</th>
                        <th>Attendance Rate</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sub in Model.SubjectBreakdowns)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@sub.SubjectCode</div>
                                <div class="text-muted small">@sub.SubjectName</div>
                            </td>
                            <td class="small text-secondary">@sub.FacultyName</td>
                            <td class="text-center fw-semibold">@sub.TotalSessions</td>
                            <td class="text-center small">
                                <span class="badge bg-success bg-opacity-10 text-success me-1">@sub.PresentSessions P</span>
                                <span class="badge bg-warning bg-opacity-10 text-warning me-1">@sub.LateSessions L</span>
                                <span class="badge bg-danger bg-opacity-10 text-danger">@sub.AbsentSessions A</span>
                            </td>
                            <td style="min-width: 180px;">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar @(sub.Percentage >= 75 ? "bg-success" : "bg-danger")" 
                                             role="progressbar" 
                                             style="width: @sub.Percentage%" 
                                             aria-valuenow="@sub.Percentage" 
                                             aria-valuemin="0" 
                                             aria-valuemax="100">
                                        </div>
                                    </div>
                                    <span class="fw-bold small @(sub.Percentage >= 75 ? "text-success" : "text-danger")" style="min-width: 45px;">
                                        @sub.Percentage%
                                    </span>
                                </div>
                            </td>
                            <td class="text-end">
                                @if (sub.IsLow)
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-exclamation-triangle"></i> Defaulter
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i> Good Standing
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-4 text-muted">
            <i class="bi bi-calendar-x fs-2"></i>
            <p class="mt-2 mb-0">No subject attendance records recorded for this term yet.</p>
        </div>
    }
</div>

<!-- Recent Attendance Activity & Monthly Chart -->
<div class="row g-4">
    <!-- Recent Attendance Log -->
    <div class="col-lg-7">
        <div class="dashboard-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Recent Class Attendances</h5>
                <a asp-controller="Reports" asp-action="StudentWise" class="small text-primary text-decoration-none fw-semibold">
                    View Complete Log &rarr;
                </a>
            </div>

            @if (Model.RecentAttendanceHistory.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var r in Model.RecentAttendanceHistory)
                    {
                        <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold" style="font-size: 0.9rem;">@r.SubjectCode - @r.SubjectName</div>
                                <div class="text-muted" style="font-size: 0.75rem;">
                                    @r.Date.ToString("ddd, dd MMM yyyy") • By @r.MarkedBy
                                    @if (!string.IsNullOrEmpty(r.Remarks))
                                    {
                                        <span class="fst-italic ms-1 text-secondary">(@r.Remarks)</span>
                                    }
                                </div>
                            </div>
                            <div>
                                @if (r.Status == "Present")
                                {
                                    <span class="status-badge status-badge-present">
                                        <i class="bi bi-check-circle-fill"></i> Present
                                    </span>
                                }
                                else if (r.Status == "Absent")
                                {
                                    <span class="status-badge status-badge-absent">
                                        <i class="bi bi-x-circle-fill"></i> Absent
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge-late">
                                        <i class="bi bi-clock-fill"></i> Late
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small">No class sessions recorded yet.</p>
            }
        </div>
    </div>

    <!-- Monthly Trend Chart -->
    <div class="col-lg-5">
        <div class="dashboard-card p-4 h-100">
            <h5 class="fw-bold mb-3">Monthly Attendance Trend</h5>
            <div style="height: 250px; position: relative;">
                <canvas id="studentMonthChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('studentMonthChart');
            if (ctx) {
                const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLabels));
                const values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyPercentages));

                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels.length ? labels : ['Current Term'],
                        datasets: [{
                            label: 'Monthly Attendance %',
                            data: values.length ? values : [@Model.OverallPercentage],
                            backgroundColor: values.map(v => v >= 75 ? '#10b981' : '#ef4444'),
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                min: 0,
                                max: 100,
                                ticks: {
                                    callback: function(v) { return v + '%'; }
                                }
                            }
                        },
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }
        });
    </script>
}
