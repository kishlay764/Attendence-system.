@model SmartAttendance.ViewModels.Management.EnrollmentManagementViewModel
@{
    ViewData["Title"] = $"Roster: {Model.ClassSectionName}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold mb-0">Class Roster: @Model.ClassSectionName</h3>
            <span class="badge bg-primary">@Model.SemesterName</span>
        </div>
        <p class="text-muted mb-0 small">Course: <strong>@Model.CourseName</strong></p>
    </div>
    <a asp-action="Sections" class="btn btn-outline-secondary bg-white">
        <i class="bi bi-arrow-left"></i> Back to Sections
    </a>
</div>

<div class="row g-4">
    <!-- Enrolled Students Table -->
    <div class="col-lg-8">
        <div class="custom-table-container">
            <div class="p-3 border-bottom bg-light fw-bold text-secondary d-flex justify-content-between align-items-center">
                <span>Enrolled Students (@Model.EnrolledStudents.Count)</span>
                <span class="small text-muted font-monospace">Active Roster</span>
            </div>

            @if (Model.EnrolledStudents.Any())
            {
                <div class="table-responsive">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Roll Number</th>
                                <th>Student Name</th>
                                <th>Email</th>
                                <th>Enrollment Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.EnrolledStudents.Count; i++)
                            {
                                var st = Model.EnrolledStudents[i];
                                <tr>
                                    <td class="text-muted small">@(i + 1)</td>
                                    <td class="fw-bold font-monospace text-primary">@st.RollNumber</td>
                                    <td class="fw-semibold">@st.FullName</td>
                                    <td class="small text-muted">@st.Email</td>
                                    <td class="small">@st.EnrollmentDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-end">
                                        <form asp-action="RemoveEnrollment" method="post" class="d-inline" onsubmit="return confirm('Remove student from this class section?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="classSectionId" value="@Model.ClassSectionId" />
                                            <input type="hidden" name="enrollmentId" value="@st.EnrollmentId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove from Roster">
                                                <i class="bi bi-person-x"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-people fs-2"></i>
                    <p class="mt-2 mb-0">No students enrolled in this section yet.</p>
                </div>
            }
        </div>
    </div>

    <!-- Add Student to Roster Panel -->
    <div class="col-lg-4">
        <div class="dashboard-card p-4">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-person-plus-fill text-primary"></i> Enroll Student
            </h5>
            <p class="text-muted small mb-3">Add students enrolled in <strong>@Model.CourseName</strong> who are not yet assigned to this section.</p>

            @if (Model.AvailableStudents.Any())
            {
                <form asp-action="EnrollStudent" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="classSectionId" value="@Model.ClassSectionId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Available Students</label>
                        <select name="studentId" class="form-select" required size="8" style="font-size: 0.88rem;">
                            @foreach (var s in Model.AvailableStudents)
                            {
                                <option value="@s.StudentId">@s.RollNumber - @s.FullName</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-semibold" style="background: var(--primary-700); border: none;">
                        <i class="bi bi-plus-lg"></i> Add Selected to Roster
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-light border small text-muted text-center py-4">
                    <i class="bi bi-check-all fs-3 text-success"></i>
                    <p class="mt-2 mb-0">All course students are already enrolled in this or other active sections.</p>
                </div>
            }
        </div>
    </div>
</div>
