@model IEnumerable<SmartAttendance.ViewModels.Management.CourseViewModel>
@{
    ViewData["Title"] = "Courses & Degree Programs";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Academic Degree Programs</h3>
        <p class="text-muted mb-0 small">Manage undergraduate and postgraduate academic degrees and departments.</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#newCourseModal" style="background: var(--primary-700); border: none;">
            <i class="bi bi-plus-circle"></i> Add Degree Course
        </button>
    </div>
</div>

<div class="custom-table-container">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Course Code</th>
                    <th>Course Name</th>
                    <th>Department</th>
                    <th>Duration</th>
                    <th>Subjects</th>
                    <th>Enrolled Students</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-bold font-monospace text-primary">@c.Code</td>
                            <td>
                                <div class="fw-bold">@c.Name</div>
                                <div class="text-muted small">@c.Description</div>
                            </td>
                            <td>@c.Department</td>
                            <td>@c.DurationYears Years</td>
                            <td>
                                <a asp-action="Subjects" asp-route-courseId="@c.Id" class="badge bg-light text-primary border text-decoration-none">
                                    @c.TotalSubjects Subjects &rarr;
                                </a>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@c.TotalStudents Students</span>
                            </td>
                            <td class="text-end">
                                <form asp-action="DeleteCourse" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this course?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Course">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-journal-x fs-2"></i>
                            <p class="mt-2 mb-0">No degree courses configured.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Add New Course -->
<div class="modal fade" id="newCourseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateCourse" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Degree Course</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Course Code</label>
                        <input name="Code" class="form-control" placeholder="e.g. BTECH-CSE" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Course Name</label>
                        <input name="Name" class="form-control" placeholder="e.g. B.Tech Computer Science & Engineering" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Department</label>
                        <input name="Department" class="form-control" placeholder="e.g. Computer Science & Engineering" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Duration (Years)</label>
                        <input name="DurationYears" type="number" min="1" max="6" value="4" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Description</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Course syllabus overview"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="background: var(--primary-700); border: none;">Create Course</button>
                </div>
            </form>
        </div>
    </div>
</div>
