@model IEnumerable<SmartAttendance.Models.Subject>
@{
    ViewData["Title"] = "Curriculum Subjects";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Curriculum Subjects</h3>
        <p class="text-muted mb-0 small">Manage academic subjects, syllabus credits, and semester distribution.</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#newSubjectModal" style="background: var(--primary-700); border: none;">
            <i class="bi bi-plus-circle"></i> Add Subject
        </button>
    </div>
</div>

<!-- Filter by Course -->
<div class="dashboard-card p-3 mb-4">
    <form method="get" asp-action="Subjects" class="d-flex align-items-center gap-3">
        <label class="fw-semibold small text-secondary text-nowrap mb-0">Filter by Degree:</label>
        <select name="courseId" class="form-select form-select-sm" asp-items="ViewBag.Courses" onchange="this.form.submit()" style="max-width: 350px;">
            <option value="">All Degree Programs</option>
        </select>
        @if (ViewBag.SelectedCourseId != null)
        {
            <a asp-action="Subjects" class="btn btn-sm btn-link text-secondary text-decoration-none">Clear Filter</a>
        }
    </form>
</div>

<div class="custom-table-container">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Subject Code</th>
                    <th>Subject Name</th>
                    <th>Course</th>
                    <th>Semester</th>
                    <th>Credits</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-bold font-monospace text-primary">@s.Code</td>
                            <td class="fw-semibold">@s.Name</td>
                            <td>@(s.Course?.Name ?? "N/A")</td>
                            <td><span class="badge bg-light text-dark border">Semester @s.SemesterNumber</span></td>
                            <td>@s.Credits Credits</td>
                            <td class="text-end">
                                <form asp-action="DeleteSubject" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this subject?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Subject">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-book fs-2"></i>
                            <p class="mt-2 mb-0">No subjects found for this program.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Add New Subject -->
<div class="modal fade" id="newSubjectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateSubject" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Curriculum Subject</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Course</label>
                        <select name="CourseId" class="form-select" asp-items="ViewBag.Courses" required>
                            <option value="">-- Select Degree Course --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Subject Code</label>
                        <input name="Code" class="form-control" placeholder="e.g. CS501" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Subject Name</label>
                        <input name="Name" class="form-control" placeholder="e.g. Database Management Systems" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-secondary">Semester Number</label>
                            <input name="SemesterNumber" type="number" min="1" max="12" value="5" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-secondary">Credits</label>
                            <input name="Credits" type="number" min="1" max="10" value="4" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="background: var(--primary-700); border: none;">Create Subject</button>
                </div>
            </form>
        </div>
    </div>
</div>
