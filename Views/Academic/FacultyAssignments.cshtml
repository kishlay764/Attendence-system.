@model IEnumerable<SmartAttendance.ViewModels.Management.FacultyAssignmentViewModel>
@{
    ViewData["Title"] = "Faculty Allocations";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Faculty Subject Allocations</h3>
        <p class="text-muted mb-0 small">Assign professors and lecturers to specific curriculum subjects and class sections.</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#newAssignmentModal" style="background: var(--primary-700); border: none;">
            <i class="bi bi-person-plus-fill"></i> New Teaching Allocation
        </button>
    </div>
</div>

<div class="custom-table-container">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Faculty Instructor</th>
                    <th>Subject Code & Name</th>
                    <th>Class Section</th>
                    <th>Academic Term</th>
                    <th>Assigned Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@a.FacultyName</div>
                                <div class="text-muted font-monospace small">@a.FacultyCode</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">@a.SubjectCode</span>
                                <div class="small fw-semibold text-secondary">@a.SubjectName</div>
                            </td>
                            <td>
                                <span class="badge bg-primary bg-opacity-10 text-primary fw-bold font-monospace">@a.ClassSectionName</span>
                            </td>
                            <td>@a.SemesterName</td>
                            <td class="small">@a.AssignedDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <form asp-action="RemoveAssignment" asp-route-id="@a.Id" method="post" class="d-inline" onsubmit="return confirm('Remove this faculty allocation?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove Allocation">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x fs-2"></i>
                            <p class="mt-2 mb-0">No faculty allocations recorded.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: New Faculty Assignment -->
<div class="modal fade" id="newAssignmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AssignFaculty" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Allocate Faculty to Class</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Faculty Instructor</label>
                        <select name="FacultyId" class="form-select" asp-items="ViewBag.FacultyList" required>
                            <option value="">-- Choose Faculty Member --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Curriculum Subject</label>
                        <select name="SubjectId" class="form-select" asp-items="ViewBag.SubjectList" required>
                            <option value="">-- Choose Subject --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Class Section</label>
                        <select name="ClassSectionId" class="form-select" asp-items="ViewBag.SectionList" required>
                            <option value="">-- Choose Section --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Academic Term</label>
                        <select name="AcademicSemesterId" class="form-select" asp-items="ViewBag.SemesterList" required>
                            <option value="">-- Choose Semester --</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="background: var(--primary-700); border: none;">Save Allocation</button>
                </div>
            </form>
        </div>
    </div>
</div>
