@model IEnumerable<SmartAttendance.ViewModels.Management.ClassSectionViewModel>
@{
    ViewData["Title"] = "Class Sections";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Class Sections & Rosters</h3>
        <p class="text-muted mb-0 small">Manage classroom divisions, student capacity, and class student rosters.</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#newSectionModal" style="background: var(--primary-700); border: none;">
            <i class="bi bi-plus-circle"></i> Add Class Section
        </button>
    </div>
</div>

<div class="custom-table-container">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Section Name</th>
                    <th>Degree Course</th>
                    <th>Academic Term</th>
                    <th>Room</th>
                    <th>Capacity</th>
                    <th>Enrolled Students</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-primary bg-opacity-10 text-primary fw-bold font-monospace fs-6">@s.Name</span>
                            </td>
                            <td>@s.CourseName</td>
                            <td>@s.SemesterName</td>
                            <td>@(s.RoomNumber ?? "TBA")</td>
                            <td>@s.Capacity Seats</td>
                            <td>
                                <span class="badge bg-light text-dark border me-2">@s.EnrolledStudentsCount Students</span>
                                <a asp-action="Enrollments" asp-route-id="@s.Id" class="small text-primary text-decoration-none fw-semibold">
                                    Manage Roster &rarr;
                                </a>
                            </td>
                            <td class="text-end">
                                <a asp-action="Enrollments" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary" title="Enroll Students">
                                    <i class="bi bi-people"></i>
                                </a>
                                <form asp-action="DeleteSection" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this section?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Section">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-grid-3x3-gap fs-2"></i>
                            <p class="mt-2 mb-0">No class sections registered.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Add New Section -->
<div class="modal fade" id="newSectionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateSection" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Class Section</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Section Name</label>
                        <input name="Name" class="form-control" placeholder="e.g. CSE-5A" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Degree Course</label>
                        <select name="CourseId" class="form-select" asp-items="ViewBag.Courses" required>
                            <option value="">-- Select Course --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Academic Term</label>
                        <select name="AcademicSemesterId" class="form-select" asp-items="ViewBag.Semesters" required>
                            <option value="">-- Select Term --</option>
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-secondary">Room Number</label>
                            <input name="RoomNumber" class="form-control" placeholder="e.g. Room 301" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-secondary">Capacity</label>
                            <input name="Capacity" type="number" min="1" max="300" value="60" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="background: var(--primary-700); border: none;">Create Section</button>
                </div>
            </form>
        </div>
    </div>
</div>
