@model IEnumerable<SmartAttendance.ViewModels.Management.AcademicSemesterViewModel>
@{
    ViewData["Title"] = "Academic Terms";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Academic Semesters & Terms</h3>
        <p class="text-muted mb-0 small">Configure active university semesters, term dates, and calendar periods.</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#newSemesterModal" style="background: var(--primary-700); border: none;">
            <i class="bi bi-calendar-plus"></i> Add Academic Term
        </button>
    </div>
</div>

<div class="custom-table-container">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Semester Name</th>
                    <th>Academic Year</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-bold">@s.Name</td>
                        <td>@s.AcademicYear</td>
                        <td>@s.StartDate.ToString("dd MMM yyyy")</td>
                        <td>@s.EndDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (s.IsCurrent)
                            {
                                <span class="badge bg-success bg-opacity-15 text-success fs-6">
                                    <i class="bi bi-check-circle-fill"></i> Current Active Term
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border">Inactive / Past</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (!s.IsCurrent)
                            {
                                <form asp-action="SetCurrentSemester" asp-route-id="@s.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                        Set as Active
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: New Semester -->
<div class="modal fade" id="newSemesterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateSemester" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Create Academic Term</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Semester Name</label>
                        <input name="Name" class="form-control" placeholder="e.g. Fall 2026, Semester 6" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Academic Year</label>
                        <input name="AcademicYear" class="form-control" placeholder="e.g. 2026-2027" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-secondary">Start Date</label>
                            <input name="StartDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-secondary">End Date</label>
                            <input name="EndDate" type="date" class="form-control" required />
                        </div>
                    </div>
                    <div class="form-check">
                        <input name="IsCurrent" type="checkbox" value="true" class="form-check-input" id="chkCurrent" />
                        <label for="chkCurrent" class="form-check-label small text-secondary">Set as Current Active Term</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="background: var(--primary-700); border: none;">Create Term</button>
                </div>
            </form>
        </div>
    </div>
</div>
