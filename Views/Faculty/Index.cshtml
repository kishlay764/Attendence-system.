@model IEnumerable<SmartAttendance.Models.Faculty>
@{
    ViewData["Title"] = "Faculty Directory";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Faculty Directory</h3>
        <p class="text-muted mb-0 small">Manage faculty staff, credentials, and subject assignments.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2" style="background: var(--primary-700); border: none;">
            <i class="bi bi-person-plus-fill"></i> Add Faculty Member
        </a>
    </div>
</div>

<!-- Filters -->
<div class="dashboard-card p-4 mb-4">
    <form method="get" asp-action="Index">
        <div class="row g-3 align-items-end">
            <div class="col-md-7">
                <label class="form-label fw-semibold small text-secondary">Search Faculty</label>
                <input type="text" name="search" class="form-control" placeholder="Search by name, faculty code, email..." value="@ViewBag.Search" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold small text-secondary">Department</label>
                <select name="department" class="form-select">
                    <option value="">All Departments</option>
                    @if (ViewBag.Departments != null)
                    {
                        foreach (string d in ViewBag.Departments)
                        {
                            <option value="@d" selected="@(d == ViewBag.SelectedDept)">@d</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100" style="background: var(--primary-700); border: none;">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Faculty Table -->
<div class="custom-table-container">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Faculty Code</th>
                    <th>Faculty Name</th>
                    <th>Department & Designation</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Allocated Classes</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var f in Model)
                    {
                        <tr>
                            <td class="fw-bold font-monospace text-primary">@f.FacultyCode</td>
                            <td>
                                <div class="fw-bold">@f.FullName</div>
                                <div class="text-muted small">@f.Qualification</div>
                            </td>
                            <td>
                                <div>@f.Designation</div>
                                <div class="text-muted small">@f.Department</div>
                            </td>
                            <td class="small">@f.Email</td>
                            <td class="small">@(f.Phone ?? "N/A")</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @f.Assignments.Count(a => a.IsActive) Allocations
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@f.Id" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-outline-primary" title="Edit Faculty">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@f.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this faculty member?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Delete Faculty">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-2"></i>
                            <p class="mt-2 mb-0">No faculty members found.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
