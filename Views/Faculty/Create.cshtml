@model SmartAttendance.ViewModels.Management.FacultyCreateEditViewModel
@{
    ViewData["Title"] = "Add Faculty Member";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1">Add Faculty Member</h3>
                <p class="text-muted mb-0 small">Create faculty profile and generate portal access account.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary bg-white">
                <i class="bi bi-arrow-left"></i> Back to Directory
            </a>
        </div>

        <div class="dashboard-card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small border-0 mb-4" role="alert"></div>

                <h5 class="fw-bold mb-3 text-primary">Faculty Information</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="FacultyCode" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="FacultyCode" class="form-control" placeholder="e.g. FAC-CS05" required />
                        <span asp-validation-for="FacultyCode" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Department" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Department" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Designation" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="Designation" class="form-select">
                            <option value="Professor & HOD">Professor & HOD</option>
                            <option value="Professor">Professor</option>
                            <option value="Associate Professor">Associate Professor</option>
                            <option value="Assistant Professor" selected>Assistant Professor</option>
                            <option value="Adjunct Lecturer">Adjunct Lecturer</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="FirstName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="FirstName" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="LastName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="LastName" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Qualification" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Qualification" class="form-control" placeholder="e.g. Ph.D. in Computer Science" />
                    </div>
                </div>

                <h5 class="fw-bold mb-3 text-primary">Contact & Account Details</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="faculty.name@smartattendance.edu" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Phone" class="form-control" placeholder="+91 98765 43210" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Minimum 6 characters" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="JoiningDate" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="JoiningDate" type="date" class="form-control" required />
                    </div>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label fw-semibold small text-secondary">Account is Active and authorized to mark attendance</label>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold" style="background: var(--primary-700); border: none;">
                        <i class="bi bi-check-circle"></i> Create Faculty Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
