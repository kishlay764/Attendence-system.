@model SmartAttendance.ViewModels.Management.FacultyCreateEditViewModel
@{
    ViewData["Title"] = "Edit Faculty Member";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1">Edit Faculty Member</h3>
                <p class="text-muted mb-0 small">Update designation, qualification, or password reset.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary bg-white">
                <i class="bi bi-arrow-left"></i> Back to Directory
            </a>
        </div>

        <div class="dashboard-card p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small border-0 mb-4" role="alert"></div>

                <h5 class="fw-bold mb-3 text-primary">Faculty Details</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="FacultyCode" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="FacultyCode" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Department" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Department" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Designation" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Designation" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="FirstName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="FirstName" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="LastName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="LastName" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Qualification" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Qualification" class="form-control" />
                    </div>
                </div>

                <h5 class="fw-bold mb-3 text-primary">Contact & Access</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Email" class="form-control bg-light" readonly />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Phone" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold small text-secondary">Reset Password (leave blank to keep current)</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="New password" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="JoiningDate" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="JoiningDate" type="date" class="form-control" required />
                    </div>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label fw-semibold small text-secondary">Account is Active</label>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold" style="background: var(--primary-700); border: none;">
                        <i class="bi bi-save"></i> Save Updates
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
