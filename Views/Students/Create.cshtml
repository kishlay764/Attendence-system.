@model SmartAttendance.ViewModels.Management.StudentCreateEditViewModel
@{
    ViewData["Title"] = "Add New Student";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1">Enroll New Student</h3>
                <p class="text-muted mb-0 small">Create academic record and generate login account credentials.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary bg-white">
                <i class="bi bi-arrow-left"></i> Back to Directory
            </a>
        </div>

        <div class="dashboard-card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small border-0 mb-4" style="border-radius: var(--radius-sm);" role="alert"></div>

                <h5 class="fw-bold mb-3 text-primary">Academic Information</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="RollNumber" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="RollNumber" class="form-control" placeholder="e.g. 26BCSE10" required />
                        <span asp-validation-for="RollNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="RegistrationNumber" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="RegistrationNumber" class="form-control" placeholder="e.g. REG2026010" required />
                        <span asp-validation-for="RegistrationNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CourseId" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="CourseId" class="form-select" asp-items="ViewBag.Courses" required>
                            <option value="">-- Select Degree Course --</option>
                        </select>
                        <span asp-validation-for="CourseId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ClassSectionId" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="ClassSectionId" class="form-select" asp-items="ViewBag.ClassSections">
                            <option value="">-- Assign Class Section --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CurrentSemester" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="CurrentSemester" type="number" min="1" max="12" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AdmissionDate" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="AdmissionDate" type="date" class="form-control" required />
                    </div>
                </div>

                <h5 class="fw-bold mb-3 text-primary">Personal Details</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="FirstName" class="form-control" required />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="LastName" class="form-control" required />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Gender" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="Gender" class="form-select">
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Phone" class="form-control" placeholder="+91 98765 43210" />
                    </div>
                </div>

                <h5 class="fw-bold mb-3 text-primary">Portal Account Credentials</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="student.name@smartattendance.edu" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Minimum 6 characters" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label fw-semibold small text-secondary">Account is Active and allowed to sign in</label>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold" style="background: var(--primary-700); border: none;">
                        <i class="bi bi-check-circle"></i> Create Student Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
